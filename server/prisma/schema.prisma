// server/prisma/schema.prisma — Neon PostgreSQL & Enterprise POS Schema
// Supports Neon Serverless PostgreSQL (neon.tech) and PostgreSQL 14+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// USERS & AUTH
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String   @default("CASHIER") // ADMIN, MANAGER, CASHIER
  status       String   @default("ACTIVE")  // ACTIVE, INACTIVE
  avatar       String?
  language     String   @default("EN")      // EN, UR

  sales          Sale[]
  purchases      Purchase[]
  stockMovements StockMovement[]
  refreshTokens  RefreshToken[]
  activityLogs   ActivityLog[]
  repairs        RepairTicket[]
  tradeIns       TradeIn[]
  expenses       Expense[]
  licenses       License[]
  products       Product[]
  customers      Customer[]
  suppliers      Supplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String?
  entityId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRODUCT CATALOG
// ═════════════════════════════════════════════════════════════════════════════

model Category {
  id          String    @id @default(cuid())
  nameEn      String
  nameUr      String?
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  logo     String?
  isActive Boolean   @default(true)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Product {
  id            String  @id @default(cuid())
  nameEn        String
  nameUr        String?
  sku           String  @unique
  barcode       String? @unique
  descriptionEn String?
  descriptionUr String?
  image         String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  purchasePrice Float
  sellingPrice  Float
  gstRate       Float   @default(17.0)
  gstInclusive  Boolean @default(false)

  minStockLevel Int     @default(5)
  currentStock  Int     @default(0)
  isActive      Boolean @default(true)

  variants       ProductVariant[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameEn     String
  nameUr     String?
  sku        String? @unique
  barcode    String? @unique
  priceDelta Float   @default(0)
  stock      Int     @default(0)

  @@map("product_variants")
}

// ═════════════════════════════════════════════════════════════════════════════
// CUSTOMERS & SUPPLIERS
// ═════════════════════════════════════════════════════════════════════════════

model Customer {
  id                 String   @id @default(cuid())
  name               String
  phone              String?  @unique
  email              String?
  address            String?
  city               String?
  cnic               String?
  creditLimit        Float    @default(0)
  outstandingBalance Float    @default(0)
  loyaltyPoints      Int      @default(0)
  isActive           Boolean  @default(true)
  notes              String?

  sales    Sale[]
  repairs  RepairTicket[]
  tradeIns TradeIn[]

  userId   String?
  user     User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Supplier {
  id                 String   @id @default(cuid())
  name               String
  company            String?
  phone              String?
  email              String?
  address            String?
  city               String?
  ntn                String?
  strn               String?
  paymentTerms       Int      @default(30)
  outstandingBalance Float    @default(0)
  isActive           Boolean  @default(true)
  notes              String?

  purchases Purchase[]

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

// ═════════════════════════════════════════════════════════════════════════════
// PURCHASES & SALES
// ═════════════════════════════════════════════════════════════════════════════

model Purchase {
  id             String    @id @default(cuid())
  purchaseNumber String    @unique
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])

  status         String    @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  purchaseDate   DateTime  @default(now())
  expectedDate   DateTime?
  receivedDate   DateTime?

  subtotal       Float     @default(0)
  gstAmount      Float     @default(0)
  discountAmount Float     @default(0)
  totalAmount    Float     @default(0)
  paidAmount     Float     @default(0)
  dueAmount      Float     @default(0)

  supplierInvoiceNo String?
  notes             String?

  items    PurchaseItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  quantity    Int
  receivedQty Int     @default(0)
  unitCost    Float
  gstRate     Float   @default(17.0)
  gstAmount   Float   @default(0)
  totalAmount Float

  @@map("purchase_items")
}

model Sale {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  status        String    @default("COMPLETED")
  saleDate      DateTime  @default(now())

  subtotal       Float
  gstAmount      Float    @default(0)
  discountAmount Float    @default(0)
  totalAmount    Float
  paidAmount     Float
  changeAmount   Float    @default(0)
  dueAmount      Float    @default(0)

  paymentMethod String    @default("CASH")
  paymentRef    String?
  notes         String?
  offlineId     String?   @unique
  syncedAt      DateTime?

  items    SaleItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity    Int
  returnedQty Int     @default(0)
  unitPrice   Float
  discountPct Float   @default(0)
  discountAmt Float   @default(0)
  gstRate     Float
  gstAmount   Float   @default(0)
  totalAmount Float

  @@map("sale_items")
}

model Payment {
  id         String    @id @default(cuid())
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  amount    Float
  method    String
  reference String?
  paidAt    DateTime  @default(now())
  notes     String?

  createdAt DateTime  @default(now())

  @@map("payments")
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  type          String
  quantity      Int
  balanceBefore Int
  balanceAfter  Int
  referenceId   String?
  referenceType String?
  reason        String?

  createdAt DateTime @default(now())

  @@map("stock_movements")
}

// ═════════════════════════════════════════════════════════════════════════════
// MOBILE REPAIR WORK ORDERS (موبائل ریپئرنگ)
// ═════════════════════════════════════════════════════════════════════════════

model RepairTicket {
  id               String    @id @default(cuid())
  ticketNo         String    @unique
  customerName     String
  customerPhone    String
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])

  deviceModel      String
  imei             String?
  color            String?
  patternLock      String?
  faultDescription String
  technicianNotes  String?

  estimatedCost    Float     @default(0)
  advanceDeposit   Float     @default(0)
  finalAmount      Float     @default(0)
  status           String    @default("RECEIVED") // RECEIVED, IN_REPAIR, READY, DELIVERED, CANCELLED

  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("repair_tickets")
}

// ═════════════════════════════════════════════════════════════════════════════
// USED MOBILE PHONE BUYBACK & POLICE VERIFICATION (استعمال شدہ موبائل خرید و فروخت)
// ═════════════════════════════════════════════════════════════════════════════

model TradeIn {
  id             String    @id @default(cuid())
  voucherNo      String    @unique
  sellerName     String
  sellerPhone    String
  sellerCnic     String
  sellerAddress  String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])

  brand          String
  modelName      String
  imei1          String
  imei2          String?
  storage        String?
  color          String?
  conditionGrade String    @default("GRADE_A") // GRADE_A, GRADE_B, GRADE_C
  purchasePrice  Float
  paymentMethod  String    @default("CASH")

  hasBox         Boolean   @default(true)
  hasCharger     Boolean   @default(true)
  hasOriginalCnicCopy Boolean @default(true)
  policeVoucherPrinted Boolean @default(false)
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("trade_ins")
}

// ═════════════════════════════════════════════════════════════════════════════
// SHOP EXPENSES & EXPENSE CATEGORIES (دکان کے اخراجات)
// ═════════════════════════════════════════════════════════════════════════════

model Expense {
  id            String   @id @default(cuid())
  title         String
  category      String   // RENT, ELECTRICITY, SALARY, TEA_REFRESHMENT, INTERNET, REPAIR_TOOLS, OTHER
  amount        Float
  paymentMethod String   @default("CASH")
  reference     String?
  expenseDate   DateTime @default(now())
  notes         String?
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("expenses")
}

// ═════════════════════════════════════════════════════════════════════════════
// SYSTEM SETTINGS & DAILY Z-REPORT CASH DRAWER
// ═════════════════════════════════════════════════════════════════════════════

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ═════════════════════════════════════════════════════════════════════════════
// SOFTWARE LICENSES & MULTI-SHOP TRIAL KEYS (لائسنس اور سبسکرپشن مینجمنٹ)
// ═════════════════════════════════════════════════════════════════════════════

model License {
  id                String    @id @default(cuid())
  licenseKey        String    @unique
  shopName          String
  ownerName         String?
  ownerPhone        String?
  duration          String    @default("15_DAYS") // 15_DAYS, 30_DAYS, 90_DAYS, 180_DAYS, 365_DAYS, LIFETIME
  status            String    @default("ACTIVE")   // ACTIVE, EXPIRED, REVOKED, UNASSIGNED
  activatedAt       DateTime  @default(now())
  expiresAt         DateTime? // Null indicates Lifetime license
  hardwareMachineId String?
  maxDevices        Int       @default(3)
  notes             String?

  userId            String?
  user              User?     @relation(fields: [userId], references: [id])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("licenses")
}

