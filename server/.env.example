# server/.env — Neon Serverless PostgreSQL Database Configuration
PORT=3001
NODE_ENV=production

# ─── NEON POSTGRESQL DATABASE URL ──────────────────────────────────────────
# Get your free serverless database URL in 30 seconds from https://neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── JWT AUTHENTICATION SECRETS ───────────────────────────────────────────
JWT_ACCESS_SECRET="hassan_traderz_jwt_access_super_secret_key_2026"
JWT_REFRESH_SECRET="hassan_traderz_jwt_refresh_super_secret_key_2026"
JWT_ACCESS_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── FRONTEND URL (For Production Deployment on Vercel / Render) ───────────
FRONTEND_URL="http://localhost:5173"
