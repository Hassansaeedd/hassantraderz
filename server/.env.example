# ─────────────────────────────────────────────────────────────────────────────
# Mobile Shop POS — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://posuser:StrongPass@123@localhost:5432/mobileshop_db?schema=public"
DB_USER=posuser
DB_PASSWORD=StrongPass@123
DB_NAME=mobileshop_db

# JWT — Generate secrets using:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_64_byte_random_access_secret_here
JWT_REFRESH_SECRET=your_64_byte_random_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=2

# Pakistan GST Settings (can be overridden from Settings table in DB)
DEFAULT_GST_RATE=17
DEFAULT_CURRENCY=PKR
DEFAULT_CURRENCY_SYMBOL=₨

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
